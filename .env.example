# Copy to .env.local and fill in.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Free from https://cloud.reown.com (formerly WalletConnect Cloud)
VITE_WALLETCONNECT_PROJECT_ID=

# Set to "true" to run the whole UI locally with fake data and no Supabase.
VITE_DEMO=false
